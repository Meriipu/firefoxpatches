Subject: [PATCH 05/10] a minimum tab width IS a minimum tab width

---
 browser/components/tabbrowser/content/tabs.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/browser/components/tabbrowser/content/tabs.js b/browser/components/tabbrowser/content/tabs.js
index 67bba60cfc21..7ecdaed8e51d 100644
--- a/browser/components/tabbrowser/content/tabs.js
+++ b/browser/components/tabbrowser/content/tabs.js
@@ -166,7 +166,8 @@
         null,
         (pref, prevValue, newValue) => this.#updateTabMinWidth(newValue),
         newValue => {
-          const LIMIT = 50;
+          // how about no
+          const LIMIT = 1;
           return Math.max(newValue, LIMIT);
         }
       );
