From 801a98fce0da4824248b76bef31d0b3286104bec Mon Sep 17 00:00:00 2001
From: Meriipu <Meriipu@users.noreply.github.com>
Date: Sun, 25 Oct 2026 21:06:02 +0100
Subject: [PATCH 07/12] urlbar: disable all search engines except ddg

firefox regularly adds sponsored search engines to your list of engines
without user-input so this patch removes any that are not ddg

if you use other engines you will probably have to edit the patch to
include those
---
 toolkit/components/search/SearchService.sys.mjs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/toolkit/components/search/SearchService.sys.mjs b/toolkit/components/search/SearchService.sys.mjs
index 2d0f0d1d9b4e..ae281fbe9be1 100644
--- a/toolkit/components/search/SearchService.sys.mjs
+++ b/toolkit/components/search/SearchService.sys.mjs
@@ -1755,6 +1755,12 @@ export const SearchService = new (class SearchService {
         );
         engineRemoved = true;
       }
+      // remove all the ad engines like ebay that mozilla keeps sneaking in
+      // if you use others than ddg I guess you have to edit the patch
+      else if (engine.name != "DuckDuckGo") {
+        await this.removeEngine(engine);
+        engineRemoved = true;
+      }
     }
     // If we've removed an engine, and we don't have any left, we need to
     // reload the engines - it is possible the settings just had one engine in it,
@@ -1798,6 +1804,12 @@ export const SearchService = new (class SearchService {
       logIgnored(engine.name, url, "submission url");
       return true;
     }
+
+    // ignore engines that are not ddg
+    if (engine.name != "DuckDuckGo") {
+      return true;
+    }
+
     return false;
   }
 
