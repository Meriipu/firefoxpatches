Date: Sun, 25 Oct 2026 12:34:08 +0100
Subject: [PATCH 08/12] newtab: center firefox logo

the logo was moved to the left for some reason if you have more than 2
rows of favourites on the new tab page so this patch requires there
being 5 or more rows for that to happen

these files dont get rebuilt automatically so we manually make these
small changes to the autogenerated files as well for the time being
https://firefox-source-docs.mozilla.org/browser/extensions/newtab/docs/index.html
---
 browser/extensions/newtab/content-src/components/Base/Base.jsx  | 2 +-
 .../extensions/newtab/data/content/activity-stream.bundle.js    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/browser/extensions/newtab/content-src/components/Base/Base.jsx b/browser/extensions/newtab/content-src/components/Base/Base.jsx
index 2e0e2859ca2e..8f18456007d5 100644
--- a/browser/extensions/newtab/content-src/components/Base/Base.jsx
+++ b/browser/extensions/newtab/content-src/components/Base/Base.jsx
@@ -1014,7 +1014,7 @@ export class BaseContent extends React.PureComponent {
         !topSitesEnabled && !pocketEnabled && !highlightsEnabled;
       const isPageEmpty =
         noContentSectionsEnabled && !prefs.showSearch && !hasAnyEnabledWidget;
-      const hasManyTopSitesRows = topSitesEnabled && prefs.topSitesRows > 2;
+      const hasManyTopSitesRows = topSitesEnabled && prefs.topSitesRows > 4;
       const logoShouldBeCentered =
         !pocketEnabled && !hasContentWidgets && !hasManyTopSitesRows;
 
diff --git a/browser/extensions/newtab/data/content/activity-stream.bundle.js b/browser/extensions/newtab/data/content/activity-stream.bundle.js
index c012fc616a3b..2cc7d15dd61f 100644
--- a/browser/extensions/newtab/data/content/activity-stream.bundle.js
+++ b/browser/extensions/newtab/data/content/activity-stream.bundle.js
@@ -26843,7 +26843,7 @@ class BaseContent extends (external_React_default()).PureComponent {
       const highlightsEnabled = prefs["feeds.section.highlights"];
       const noContentSectionsEnabled = !topSitesEnabled && !pocketEnabled && !highlightsEnabled;
       const isPageEmpty = noContentSectionsEnabled && !prefs.showSearch && !hasAnyEnabledWidget;
-      const hasManyTopSitesRows = topSitesEnabled && prefs.topSitesRows > 2;
+      const hasManyTopSitesRows = topSitesEnabled && prefs.topSitesRows > 4;
       const logoShouldBeCentered = !pocketEnabled && !hasContentWidgets && !hasManyTopSitesRows;
       return /*#__PURE__*/external_React_default().createElement(BaseContext.Provider, {
         value: baseContextValue
