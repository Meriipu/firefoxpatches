From 9918e491105d23a06f276bd7641b5e1a4e6e5de0 Mon Sep 17 00:00:00 2001
From: Meriipu <Meriipu@users.noreply.github.com>
Date: Sun, 25 Oct 2026 14:09:32 +0100
Subject: [PATCH 09/12] newtab: increase padding between pinned sites

the pinned sites have cramped padding so increase the padding so it is
closer to how it was in 140 and earlier

these files dont get rebuilt automatically so we manually make these
small changes to the autogenerated files as well for the time being
https://firefox-source-docs.mozilla.org/browser/extensions/newtab/docs/index.html
---
 .../extensions/newtab/content-src/styles/nova/_TopSites.scss  | 4 ++--
 browser/extensions/newtab/css/activity-stream.css             | 4 ++--
 browser/extensions/newtab/css/nova/activity-stream.css        | 4 ++--
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/browser/extensions/newtab/content-src/styles/nova/_TopSites.scss b/browser/extensions/newtab/content-src/styles/nova/_TopSites.scss
index 965a230d05f8..255fdd5e6597 100644
--- a/browser/extensions/newtab/content-src/styles/nova/_TopSites.scss
+++ b/browser/extensions/newtab/content-src/styles/nova/_TopSites.scss
@@ -15,8 +15,8 @@
 
 .nova-enabled .top-sites-list {
   grid-template-columns: repeat(6, auto);
-  column-gap: var(--space-medium);
-  row-gap: var(--space-large);
+  column-gap: var(--space-xxlarge);
+  row-gap: var(--space-xlarge);
 
   .nova-hide-for-xs,
   .nova-hide-for-s {
diff --git a/browser/extensions/newtab/css/activity-stream.css b/browser/extensions/newtab/css/activity-stream.css
index 5f86582a578c..5df248bd4c8d 100644
--- a/browser/extensions/newtab/css/activity-stream.css
+++ b/browser/extensions/newtab/css/activity-stream.css
@@ -16112,8 +16112,8 @@ hr {
 
 .nova-enabled .top-sites-list {
   grid-template-columns: repeat(6, auto);
-  column-gap: var(--space-medium);
-  row-gap: var(--space-large);
+  column-gap: var(--space-xxlarge);
+  row-gap: var(--space-xlarge);
 }
 .nova-enabled .top-sites-list .nova-hide-for-xs,
 .nova-enabled .top-sites-list .nova-hide-for-s {
diff --git a/browser/extensions/newtab/css/nova/activity-stream.css b/browser/extensions/newtab/css/nova/activity-stream.css
index ebfc9c81df4c..11e627417344 100644
--- a/browser/extensions/newtab/css/nova/activity-stream.css
+++ b/browser/extensions/newtab/css/nova/activity-stream.css
@@ -15052,8 +15052,8 @@ hr {
 
 .nova-enabled .top-sites-list {
   grid-template-columns: repeat(6, auto);
-  column-gap: var(--space-medium);
-  row-gap: var(--space-large);
+  column-gap: var(--space-xxlarge);
+  row-gap: var(--space-xlarge);
 }
 .nova-enabled .top-sites-list .nova-hide-for-xs,
 .nova-enabled .top-sites-list .nova-hide-for-s {
-- 
